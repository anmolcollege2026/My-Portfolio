# ==============================================================================
# EMAIL TRANSMISSION API KEY CONFIGURATION
# ==============================================================================

# OPTION 1: Web3Forms (Easiest - 1 key, free, zero setup)
# Get a free key at https://web3forms.com (just enter your email address)
VITE_EMAIL_API_KEY=your_web3forms_access_key_here

# OPTION 2: EmailJS (Alternative)
# Get credentials at https://www.emailjs.com
# VITE_EMAILJS_SERVICE_ID=your_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_template_id
# VITE_EMAILJS_PUBLIC_KEY=your_public_key